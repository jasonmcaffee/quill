/target
reference/
# The accepted images are kept; the three a differing run writes beside them are not. The second
# pattern of each pair covers the per-platform folders, such as tests/snapshots/windows.
**/tests/snapshots/*.new.png
**/tests/snapshots/*.diff.png
**/tests/snapshots/*.old.png
**/tests/snapshots/**/*.new.png
**/tests/snapshots/**/*.diff.png
**/tests/snapshots/**/*.old.png

# IntelliJ workspace state, which is per machine rather than part of the project.
.idea/

# What Unluminous remembers about a project it has open: the tabs, the folders that were opened out, the
# terminal. Per person and per machine rather than part of the project, the same as `.idea` above.
.unluminous/

# What the two installer build scripts write.
/installer/dist/

# The finished installers. They are staged in `releases/` and uploaded to the GitHub release by
# `tools/release.ps1`, which is where a downloadable file belongs; a 7 MB installer per finished
# task is not something a git repository should carry. `releases/unluminous-0.1.0.dmg` predates this and
# is still tracked.
/releases/*.exe
/releases/*.dmg

# The icon generator is a workspace of its own, so it has a target folder of its own.
/installer/icon/target/

# Anything an agent writes while working: captures, logs, comparisons.
/_agent_output/

AuthKey_K2466BV829.p8
# The signing identity and notarising credentials, which are per machine and partly secret.
installer/macos/notarize.env
